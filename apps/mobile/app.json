{
  "expo": {
    "name": "Vaultix",
    "slug": "vaultix-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vaultix",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.vaultix.mobile",
      "associatedDomains": ["applinks:vaultix.app", "applinks:www.vaultix.app"]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "io.vaultix.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "vaultix.app",
              "pathPrefix": "/escrow"
            },
            {
              "scheme": "https",
              "host": "vaultix.app",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "www.vaultix.app",
              "pathPrefix": "/escrow"
            },
            {
              "scheme": "https",
              "host": "www.vaultix.app",
              "pathPrefix": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Vaultix to access your camera to scan Stellar addresses and escrow IDs.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://vaultix.app"
      }
    }
  }
}
